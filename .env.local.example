# Supabase Configuration
# Get these values from: Supabase Dashboard -> Settings -> API

# Project URL
SUPABASE_URL=your_supabase_url

# Service Role Key (secret - server-side only)
# WARNING: Never expose this key in client-side code
SUPABASE_SERVICE_KEY=your_service_role_key

# Public key (safe for browser — used for anonymous auth)
# NEXT_PUBLIC_SUPABASE_URL is auto-derived from SUPABASE_URL in next.config.ts
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key
